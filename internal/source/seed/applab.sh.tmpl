#!/bin/sh
# The full lifecycle of this app, from a shell, with nothing but curl.
#
# This file is written by AppLab on every upload — edit it and your changes are
# gone with the next push. It is the same on every app; what changes is the
# APP below.
#
# It needs curl and a key, and nothing else:
#
#     export APPLAB_URL="https://applab.example.com"
#     export APPLAB_KEY="<the app's key>"
#     ./applab.sh status
#
# "Nothing else" is meant exactly, and it is worth listing because this script is
# copied into every repository and run from wherever it was checked out: whatever
# it needs has to already be on the machine. Beyond curl it uses only what a
# POSIX shell and a base system ship, and nothing here has to be installed.
#
#     curl                      every request, and the upload
#     sed                       the URLs, the JSON it builds, the fields it reads
#     printf, cat, head         output, and reading a response
#     tar                       packaging the directory      (push, upload)
#     sleep                     waiting on a build           (push)
#     grep, tr                  finding the build in flight  (cancel)
#     read                      typing the app id to confirm (delete)
#     dirname, pwd, mv, chmod, rm   replacing the script     (self-update)
#
# There is deliberately no jq. A JSON parser is exactly the kind of tool that is
# on a developer's laptop and absent from a build image, and the fields this
# script reads are few and fixed, so they go through sed instead — see json_field
# for what that does and does not handle.
#
# The key is deliberately not built into this script. This repository is cloned,
# uploaded, built into an image and mirrored like any other source, so a key
# written here would travel everywhere the source goes — and it is a credential
# that can deploy this app. Get it from whoever runs the deployment:
# `GET /api/v1/apps/APP/key` with an admin key returns it, and `applab keys APP`
# prints it. Put it in the environment, where it is not committed, not built and
# not cloned.
#
# Run `./applab.sh help` for the commands.

set -eu

APP="{{APP}}"

: "${APPLAB_URL:?set APPLAB_URL to the deployment, e.g. https://applab.example.com}"
: "${APPLAB_KEY:?set APPLAB_KEY to the key for this app; see the notes at the top of this file}"

# Every call is JSON in and JSON out. Success is the payload under "data";
# failure is a non-2xx with {"error": "..."} and sometimes {"retryable": true}.
# The -f makes curl exit non-zero on a non-2xx, which is what lets the shell
# stop instead of acting on an error body.
api() {
  method="$1"; path="$2"; body="${3:-}"
  if [ -n "$body" ]; then
    curl -fsS -X "$method" "$APPLAB_URL$path" \
      -H "Authorization: Bearer $APPLAB_KEY" \
      -H "Content-Type: application/json" \
      -d "$body"
  else
    curl -fsS -X "$method" "$APPLAB_URL$path" \
      -H "Authorization: Bearer $APPLAB_KEY"
  fi
}

# urlencode makes a value safe to put in a query string.
#
# Commit messages are free text, and a space in one is enough to make curl reject
# the whole URL — which it does by exiting non-zero *before* sending anything, so
# a missing encoding is not a mangled message, it is no message and no upload.
#
# Only the characters a commit message plausibly contains *and* that carry
# meaning in a URL are replaced. Anything else — including every non-ASCII byte
# of a message written in another language — is left as it stands, which is what
# the API expects from a UTF-8 query value.
urlencode() {
  printf '%s' "$1" | sed \
    -e 's/%/%25/g' \
    -e 's/ /%20/g' \
    -e 's/&/%26/g' \
    -e 's/#/%23/g' \
    -e 's/?/%3F/g' \
    -e 's/+/%2B/g' \
    -e 's/=/%3D/g' \
    -e "s/'/%27/g"
}

# json_escape makes a value safe to put inside a JSON string.
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# json_pairs builds {"<wrapper>":{"K":"V",...}} from KEY=VALUE arguments.
#
# The value may contain "=" — a connection string is the common case — so the
# split is on the first one only. A value containing a quote or a backslash is
# escaped rather than refused: a password is exactly the kind of thing that
# contains one, and telling the caller to go and change it would be absurd.
json_pairs() {
  wrapper="$1"; shift
  [ "$#" -gt 0 ] || { echo "expected at least one KEY=VALUE" >&2; return 1; }

  out=""
  for pair in "$@"; do
    key="${pair%%=*}"
    if [ "$key" = "$pair" ]; then
      echo "expected KEY=VALUE, got: $pair" >&2
      return 1
    fi
    out="$out\"$(json_escape "$key")\":\"$(json_escape "${pair#*=}")\","
  done
  printf '{"%s":{%s}}' "$wrapper" "${out%,}"
}

# json_field reads one field out of a JSON response, so the script does not
# depend on jq.
#
# Two forms, because the API returns both: a string value is quoted and a number
# or boolean is not. Matching only the quoted form silently returns nothing for
# `replicas`, which reads as "the app has no replica count" rather than as a
# parse that did not apply.
#
# The input is read once and searched twice rather than piped twice: the caller
# hands it over on stdin, and a second read would find nothing.
json_field() {
  input=$(cat)

  value=$(printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1)
  if [ -z "$value" ]; then
    value=$(printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\([^,}[:space:]]*\).*/\1/p" | head -1)
  fi

  printf '%s' "$value"
}

# branch_list prints the branches from a /branches response, marking the active
# one.
#
# The response is {"app_id":"…","branches":["main","dev"],"active":"main"} and it
# is read with sed rather than parsed, like json_field and for the same reason:
# this script is expected to work over a bare base system with no jq. The array
# is taken as the text between the first "[" and the "]" that closes it, split on
# commas, and each element stripped of its quotes.
#
# The mark matches the console's and the CLI's: the active branch is the one you
# are looking for, and * next to it is a glance rather than a search.
branch_list() {
  input=$(cat)
  active=$(printf '%s' "$input" | json_field active)
  list=$(printf '%s' "$input" | sed -n 's/.*"branches"[: ]*\[\([^]]*\)\].*/\1/p' | head -1)

  if [ -z "$list" ]; then
    echo "this app has no branches yet" >&2
    echo "push to create one: git push <remote> HEAD" >&2
    return 0
  fi

  printf '%s\n' "$list" | tr ',' '\n' | while read -r name; do
    name=$(printf '%s' "$name" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
    [ -n "$name" ] || continue
    if [ "$name" = "$active" ]; then
      echo "* $name"
    else
      echo "  $name"
    fi
  done
}

# The app's own id, so the script works without a key for anything local.
usage() {
  cat <<'EOF'
usage: ./applab.sh <command>

Source
  push [message]     upload this directory, build it and deploy it
  upload [message]   upload this directory without building
  build [commit]     build a commit (default: the newest)
  cancel [build]     stop a build (default: the one in flight)
  deploy [commit]    deploy a commit (default: the newest), building it if needed
  rollback <commit>  deploy an earlier commit, reusing its image

Looking
  status             what is running, and where
  url                just the address the app is served at
  show               the app itself: port, replicas, domain, address
  logs [-f]          the app's log; -f follows it
  pods               the pods, and why one is not ready
  diagnose           why the app is not working, if it is not
  history            the commit history
  builds             the build history
  config             environment variables, and the names of the secrets

Changing
  replicas [n]       how many copies to run (no argument: print the current one)
  resources          what it is using, and the bounds it runs under
  resources set K=V  set cpu/memory request and limit, e.g. memory_limit=512Mi
                     (an empty value clears it back to the deployment default)
  env set K=V ...    set environment variables
  env unset K ...    remove environment variables
  secret set K=V ... set secret values
  secret unset K ... remove secrets
  restart            roll the pods, keeping the same image
  stop               remove the running app, keeping the source
  delete <app>       delete the app and its history (needs an admin key)

Branches
  branch             the branches this app has, and which one is running
  branch use <name>  switch to a branch and deploy it

  A branch is created by pushing to it — git's own rule. Switching replaces what
  is running: one app runs one branch at a time.

  git push  "https://x:$APPLAB_KEY@<host>/git/<app>@dev.git" HEAD:dev
  git clone "https://x:$APPLAB_KEY@<host>/git/<app>.git"        the active branch
  git clone "https://x:$APPLAB_KEY@<host>/git/<app>@dev.git"    the branch dev

  See AGENT.md for more, and the app's page in the console has both addresses.

Keys and upkeep
  key                print this app's key
  self-update        fetch the current applab.sh and AGENT.md from the deployment
  help               this

Environment:
  APPLAB_URL   the deployment, e.g. https://applab.example.com   (required)
  APPLAB_KEY   the key for this app                              (required)
EOF
}

# push packages this directory the way AppLab expects.
#
# The exclusions are the ones that would make an upload slower and a build no
# more correct: build output, dependencies and the git directory itself. A
# .gitignore is honoured by nothing here — the archive *is* the statement of what
# to store, so what is listed is what lands.
package() {
  tar czf - \
    --exclude=./.git \
    --exclude=./node_modules \
    --exclude=./target \
    --exclude=./.venv \
    --exclude=./__pycache__ \
    --exclude=./applab.sh \
    --exclude=./AGENT.md \
    .
}

upload() {
  message="$(urlencode "${1:-upload from applab.sh}")"

  # The response is captured first and the commit extracted from it, rather than
  # piping curl into json_field. Piping hides curl's exit status — a pipeline
  # reports the last command's, and json_field succeeds on empty input — so a
  # refused upload would return an empty commit and the caller would carry on to
  # build nothing. Assigning from a command substitution is not exempt from a
  # failure either: the assignment has to be checked, which `if !` does.
  response=$(package | curl -fsS -X POST \
    "$APPLAB_URL/api/v1/apps/$APP/source?message=$message" \
    -H "Authorization: Bearer $APPLAB_KEY" \
    -H "Content-Type: application/gzip" \
    --data-binary @-) || return 1

  sha=$(printf '%s' "$response" | json_field commit_sha)
  if [ -z "$sha" ]; then
    echo "the upload was accepted but named no commit: $response" >&2
    return 1
  fi
  printf '%s' "$sha"
}

# self-update replaces this script and AGENT.md with the deployment's current
# copies.
#
# AppLab's API changes between releases, and these files are written into the
# repository on every upload — so a checkout that has not been pushed in a while
# carries a script that may call an endpoint that no longer exists. Fetching the
# current version from the running server is what makes that recoverable without
# a push, and it is the same content the next upload would write anyway.
#
# The script is self-modifying, and it is the only file it could mean — but the
# directory it writes to is the one the script lives in, not the one the caller
# happens to be standing in. `../applab.sh self-update` from a subdirectory must
# replace the script, not drop a second copy into the subdirectory.
#
# Each file is written to a temporary and then moved, so an interrupted or failed
# download cannot leave a half-written script where a working one was.
self_update() {
  dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

  for name in applab.sh AGENT.md; do
    url="$APPLAB_URL/api/v1/apps/$APP/agent/files/$name"
    tmp="$dir/$name.applab-new"

    if ! curl -fsS -H "Authorization: Bearer $APPLAB_KEY" "$url" -o "$tmp"; then
      rm -f "$tmp"
      echo "could not fetch $name from $url" >&2
      return 1
    fi
    # An empty response is not the file, and writing it would replace a working
    # script with something that cannot run.
    if [ ! -s "$tmp" ]; then
      rm -f "$tmp"
      echo "$name came back empty; nothing was replaced" >&2
      return 1
    fi
    if [ "$name" = "applab.sh" ]; then
      chmod +x "$tmp"
    fi
    mv "$tmp" "$dir/$name"
    echo "updated $dir/$name" >&2
  done

  echo "re-run the script to use the new version" >&2
}

# require_app_matches guards the one command that is not about a single app.
#
# `delete` takes the id as an argument because it is irreversible and the id has
# to come from the caller rather than from a file the caller may not have read.
# Checking it against APP is what stops the wrong one being deleted by a script
# run from the wrong directory.
require_app_matches() {
  [ "$1" = "$APP" ] || {
    echo "this repository is $APP, not $1" >&2
    echo "delete names the app explicitly because there is no undo" >&2
    exit 2
  }
}

case "${1:-help}" in
  push)
    shift
    sha=$(upload "${1:-push from applab.sh}")
    echo "committed $sha" >&2
    api POST "/api/v1/apps/$APP/builds" "{\"commit_sha\":\"$sha\"}" >/dev/null
    echo "building; the first build has no cache and takes a while" >&2
    # A build is a Job, so it is polled rather than waited on by the API. The
    # loop is bounded so a wedged build fails here instead of hanging forever.
    i=0
    while [ "$i" -lt 180 ]; do
      state=$(api GET "/api/v1/apps/$APP/builds/$sha" | json_field status)
      case "$state" in
        succeeded) break ;;
        failed|build-failed) echo "build failed; see: ./applab.sh builds" >&2; exit 1 ;;
      esac
      i=$((i + 1)); sleep 5
    done
    api POST "/api/v1/apps/$APP/deploy" "{\"commit_sha\":\"$sha\"}" | json_field url
    ;;
  upload)
    shift
    upload "$@"
    ;;
  build)
    shift
    api POST "/api/v1/apps/$APP/builds" "{\"commit_sha\":\"${1:-}\"}"
    ;;
  cancel)
    shift
    # The build to stop: one named on the command line, or whatever is in flight.
    # Naming it is how a specific build is stopped; naming nothing is what someone
    # means after a push has gone wrong, which is "stop what you are doing".
    if [ -n "${1:-}" ]; then
      id="$1"
    else
      # The newest build that has not finished. `builds` is newest first, so the
      # first non-terminal status in the list is the one running. json_field reads
      # one field per call and the list is a single line per build, so this walks
      # the ids and statuses together rather than parsing the array.
      listing=$(api GET "/api/v1/apps/$APP/builds?limit=20")
      id=$(printf '%s' "$listing" | tr '{' '\n' | grep -v '"status":"succeeded"' \
        | grep -v '"status":"failed"' | grep -v '"status":"cancelled"' \
        | sed -n 's/.*"id":"\([^"]*\)".*/\1/p' | head -1)
    fi

    [ -n "$id" ] || { echo "nothing is building" >&2; exit 0; }
    api DELETE "/api/v1/apps/$APP/builds/$id" | json_field status
    echo
    echo "stopped $id" >&2
    ;;
  deploy)
    shift
    # build:true so this does not refuse for the one reason that would make it
    # useless — a commit uploaded but not yet built. A commit that already has an
    # image reuses it, so the common case is not a rebuild. This is what the
    # console's "Deploy latest" does, and the two have to agree.
    api POST "/api/v1/apps/$APP/deploy" "{\"commit_sha\":\"${1:-}\",\"build\":true}"
    ;;
  rollback)
    shift
    [ -n "${1:-}" ] || { echo "rollback needs a commit; see ./applab.sh history" >&2; exit 2; }
    api POST "/api/v1/apps/$APP/rollback" "{\"commit_sha\":\"$1\"}"
    ;;
  status)
    api GET "/api/v1/apps/$APP/status"
    ;;
  logs)
    shift
    if [ "${1:-}" = "-f" ]; then follow=true; else follow=false; fi
    api GET "/api/v1/apps/$APP/logs?follow=$follow&tail=500"
    ;;
  diagnose)
    api GET "/api/v1/apps/$APP/diagnose"
    ;;
  history)
    api GET "/api/v1/apps/$APP/commits?limit=50"
    ;;
  builds)
    api GET "/api/v1/apps/$APP/builds?limit=20"
    ;;
  url)
    api GET "/api/v1/apps/$APP/status" | json_field url
    ;;
  show)
    api GET "/api/v1/apps/$APP"
    ;;
  pods)
    api GET "/api/v1/apps/$APP/pods"
    ;;
  config)
    api GET "/api/v1/apps/$APP/config"
    ;;
  replicas)
    shift
    if [ "$#" -eq 0 ]; then
      # No argument reads, which is the other half of what someone wants from a
      # setting: the value is in `show` too, but this is the one they will reach
      # for after setting it. `exit` rather than `break` — this is a case arm,
      # not a loop, and `break` here would fall through to the argument handling
      # below and read an argument that was never given.
      api GET "/api/v1/apps/$APP" | json_field replicas
      exit 0
    fi
    # The range is checked here as well as on the server, the same way the
    # console checks it: the server's answer is a 400 naming a parameter, and
    # "between 1 and 50" is the answer that tells the caller what to do.
    case "$1" in
      ''|*[!0-9]*) echo "replicas takes a whole number" >&2; exit 2 ;;
    esac
    if [ "$1" -lt 1 ] || [ "$1" -gt 50 ]; then
      echo "replicas must be between 1 and 50" >&2
      exit 2
    fi
    api PATCH "/api/v1/apps/$APP" "{\"replicas\":$1}" | json_field replicas
    echo
    echo "set; it takes effect on the next deploy" >&2
    ;;
  resources)
    shift
    case "${1:-}" in
      '')
        # No argument reads, and the reading is the point of the command: usage
        # comes from the cluster's metrics API, and the bounds beside it are the
        # effective ones — the app's settings with this deployment's defaults
        # already resolved onto the fields the app left empty.
        api GET "/api/v1/apps/$APP/resources"
        ;;
      set)
        shift
        [ "$#" -gt 0 ] || { echo "resources set takes at least one key=value" >&2; exit 2; }
        body=""
        for pair in "$@"; do
          name="${pair%%=*}"
          if [ "$name" = "$pair" ]; then
            echo "expected KEY=VALUE, got: $pair" >&2
            exit 2
          fi
          # The four names are the API's own field names rather than a shorter
          # spelling of them: a mapping between two vocabularies is a place for
          # them to drift, and underscores are as easy to type as anything else.
          case "$name" in
            cpu_request|cpu_limit|memory_request|memory_limit) ;;
            *) echo "unknown resource: $name (cpu_request, cpu_limit, memory_request, memory_limit)" >&2; exit 2 ;;
          esac
          [ -n "$body" ] && body="$body,"
          body="$body\"$name\":\"$(json_escape "${pair#*=}")\""
        done
        api PATCH "/api/v1/apps/$APP" "{\"resources\":{$body}}"
        echo
        echo "set; it takes effect on the next deploy" >&2
        ;;
      *)
        echo "resources takes no argument to read, or: resources set K=V ..." >&2
        exit 2
        ;;
    esac
    ;;
  env)
    shift
    case "${1:-}" in
      set)
        shift
        api PUT "/api/v1/apps/$APP/env" "$(json_pairs env "$@")"
        ;;
      unset)
        shift
        for name in "$@"; do
          api DELETE "/api/v1/apps/$APP/env/$(urlencode "$name")" >/dev/null
          echo "removed $name" >&2
        done
        ;;
      *)
        echo "usage: ./applab.sh env set K=V ... | env unset K ..." >&2
        exit 2
        ;;
    esac
    ;;
  secret)
    shift
    case "${1:-}" in
      set)
        shift
        api PUT "/api/v1/apps/$APP/secrets" "$(json_pairs secrets "$@")"
        ;;
      unset)
        shift
        for name in "$@"; do
          api DELETE "/api/v1/apps/$APP/secrets/$(urlencode "$name")" >/dev/null
          echo "removed $name" >&2
        done
        ;;
      *)
        echo "usage: ./applab.sh secret set K=V ... | secret unset K ..." >&2
        exit 2
        ;;
    esac
    ;;
  branch)
    shift
    if [ "${1:-}" = "use" ]; then
      shift
      [ -n "${1:-}" ] || { echo "usage: ./applab.sh branch use <branch>" >&2; exit 2; }
      # Escaped rather than interpolated bare: git allows a `"` in a ref name, so
      # a caller can reach here with one, and unescaped it would end the string
      # and make the request malformed. Whether the name is otherwise acceptable
      # is the server's answer, not this script's.
      api PUT "/api/v1/apps/$APP/branch" \
        "{\"branch\":\"$(json_escape "$1")\"}" >/dev/null
      # Reported as building rather than as deployed: the switch deploys the
      # branch's tip, and a branch that was just pushed has no image yet, so the
      # common case is a build. Saying "deployed" would have the caller expecting
      # to find it serving.
      echo "switched to $1; see ./applab.sh status" >&2
      exit 0
    fi
    api GET "/api/v1/apps/$APP/branches" | branch_list
    ;;
  restart)
    api POST "/api/v1/apps/$APP/restart" >/dev/null
    echo "rolling the pods" >&2
    ;;
  stop)
    api POST "/api/v1/apps/$APP/stop" >/dev/null
    echo "stopped; the source and history are kept, so a deploy brings it back" >&2
    ;;
  delete)
    shift
    [ -n "${1:-}" ] || { echo "usage: ./applab.sh delete <app>" >&2; exit 2; }
    require_app_matches "$1"
    # Typed out rather than confirmed, for the same reason the console makes you
    # type it: this removes the source, the history and the running app, and
    # there is nothing to undo it with. A `y` at a prompt is one keystroke from a
    # mistyped command.
    printf 'This deletes %s, its source and its history, with no undo.\nType the app id to confirm: ' "$APP" >&2
    read -r typed
    [ "$typed" = "$APP" ] || { echo "not deleted" >&2; exit 1; }
    api DELETE "/api/v1/apps/$APP" >/dev/null
    echo "deleted $APP" >&2
    ;;
  key)
    api GET "/api/v1/apps/$APP/key" | json_field key
    ;;
  self-update)
    self_update
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
