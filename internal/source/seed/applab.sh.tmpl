#!/bin/sh
# The full lifecycle of this app, from a shell, with nothing but curl.
#
# This file is written by AppLab on every upload — edit it and your changes are
# gone with the next push. It is the same on every app; what changes is the
# APP below, and the two variables under it.
#
# It needs curl and nothing else:
#
#     ./applab.sh status
#
# APPLAB_URL and APPLAB_KEY are filled in below, so a fresh clone runs with
# nothing exported. Both are defaults: export either one and it wins, which is
# what someone working against a second deployment, or with a key they rotated,
# wants.
#
# "Nothing else" is meant exactly, and it is worth listing because this script is
# copied into every repository and run from wherever it was checked out: whatever
# it needs has to already be on the machine. Beyond curl it uses only what a
# POSIX shell and a base system ship, and nothing here has to be installed.
#
#     curl                      every request, and the upload
#     sed                       the URLs, the JSON it builds, the fields it reads
#     printf, cat, head         output, and reading a response
#     tar                       packaging the directory      (push, upload)
#     sleep                     waiting on a build           (push)
#     grep, tr                  finding the build in flight  (cancel)
#     read                      typing the app id to confirm (delete)
#     dirname, pwd, mv, chmod, rm   replacing the script     (self-update,
#                               and the refresh every command does first)
#     cmp                       has the script changed?      (the same refresh)
#     mktemp, dd, wc            sending a large upload in parts, which needs the
#                               archive staged and measured first — the one path
#                               here that cannot stream, and one only a tree over
#                               the deployment's single-request limit takes
#
# There is deliberately no jq. A JSON parser is exactly the kind of tool that is
# on a developer's laptop and absent from a build image, and the fields this
# script reads are few and fixed, so they go through sed instead — see json_field
# for what that does and does not handle.
#
# THE SCRIPT REFRESHES ITSELF BEFORE EVERY COMMAND. AppLab's API changes between
# releases, and this file is written into the repository on every upload, so a
# checkout that has not been pushed in a while carries a version that may call an
# endpoint that no longer exists. Rather than fail there, every command first
# fetches the deployment's current applab.sh and AGENT.md and re-runs itself from
# the new copy — so `./applab.sh push` behaves the way *this* deployment's push
# behaves, whatever the checkout is carrying. It costs one request, and it is
# skipped when the copy is already current. Set APPLAB_NO_REFRESH=1 to turn it
# off, which is what a caller who wants a specific pinned version does.
#
# THE KEY BELOW IS A CREDENTIAL, AND THIS REPOSITORY IS NOT PRIVATE. It is
# cloned, uploaded, built into an image and mirrored like any other source, so
# the key travels with every copy of it — including into an image layer, if this
# directory is what gets built. It reaches this app and nothing else: upload,
# build, deploy, read logs, change this app's configuration. It cannot delete the
# app and cannot see any other app on the platform.
#
# It is recoverable rather than fatal, which is why it is here at all. Whoever
# runs the deployment can replace it with `applab keys rotate APP`, and the old
# value stops working at once; the next upload then writes the new one in. Until
# that happens, treat a copy of this repository as a copy of the credential.
#
# Nothing else should be written here. A value this app actually needs at runtime
# belongs in its environment or its secret configuration — `./applab.sh env set`
# and `./applab.sh secret set` — which is applied to the container on the next
# deploy and is not part of the source at all.
#
# Run `./applab.sh help` for the commands.

set -eu

# The app this script is about, and the deployment. All three are defaults — see
# the header — and each yields to the environment.
#
# APP is empty in the copy fetched from the deployment's own bootstrap route,
# which is the copy someone with no app yet has. That is not a broken state: the
# `create` and `use` commands below are what fill it in, and `use` remembers the
# choice in a file beside the script so it does not have to be repeated. A copy
# written into a repository has the app's id here, so it is driven the same way
# but never asks.
APP="${APPLAB_APP:-{{APP}}}"

# Where a `use` writes the app it chose. Alongside the script rather than in the
# home directory, so that one checkout of one app cannot retarget another — and
# so that deleting the directory forgets the choice, which is what someone
# cleaning up expects. It is keyed off this file's own name for that reason.
APPLAB_STATE="$(dirname "$0")/.applab-app"

# A copy fetched from the bootstrap route has no app in it, and a `use` may have
# chosen one. Yielding to the environment first is what keeps a caller able to
# say "this command is about that app" without editing the file.
if [ -z "$APP" ] && [ -f "$APPLAB_STATE" ]; then
  APP="$(cat "$APPLAB_STATE" 2>/dev/null || true)"
fi

APPLAB_URL="${APPLAB_URL:-{{URL}}}"
APPLAB_KEY="${APPLAB_KEY:-{{KEY}}}"

# APPLAB_SERVER names another AppLab deployment registered on this one, or is
# empty for this deployment. It is set by the --server flag on the handful of
# commands that act on a deployment rather than on this app — see api_root, which
# is what makes a request go to the relay instead of here.
APPLAB_SERVER="${APPLAB_SERVER:-}"

: "${APPLAB_URL:?set APPLAB_URL to the deployment, e.g. https://applab.example.com}"

# The key is checked per command rather than here, because two of them do not
# need one: `help` explains the script without reaching the deployment, and
# `create` is the command a caller with no key runs to find out they need one.
# Demanding it at the top would make the script unable to say what it is for
# until someone already had a way in.
require_key() {
  [ -n "$APPLAB_KEY" ] || {
    echo "this command needs a key for an app." >&2
    echo >&2
    echo "If you have one already:      export APPLAB_KEY=<key>" >&2
    echo "If you are starting from here: export APPLAB_KEY=<admin key>, then" >&2
    echo "                              $0 create <app>" >&2
    exit 2
  }
}

# require_app is the other half: a command about one app needs to know which.
require_app() {
  [ -n "$APP" ] || {
    echo "this script does not know which app it is about." >&2
    echo >&2
    echo "Choose one:  $0 use <app>" >&2
    echo "Make one:    $0 create <app>" >&2
    exit 2
  }
}

# app_path is where the app collection lives: this deployment's own, or — with
# --server <id> — the relay that reaches the named remote's, run by this
# deployment with the key it stored for it. One route, the same shape, so `list`,
# `create` and `delete` do not care which side of the relay they are on.
app_path() {
  if [ -n "$APPLAB_SERVER" ]; then
    printf '/api/v1/servers/%s/apps' "$APPLAB_SERVER"
  else
    printf '/api/v1/apps'
  fi
}

# take_server consumes a leading `--server <id>` if one is there, setting
# APPLAB_SERVER, and returns non-zero when there was none. Commands that take it
# call it once at the top of their arm, so the flag comes before the command's own
# argument: `./applab.sh create --server lab-2 shop`.
take_server() {
  [ "${1:-}" = "--server" ] || return 1
  [ -n "${2:-}" ] || { echo "--server needs a name; see ./applab.sh servers" >&2; exit 2; }
  APPLAB_SERVER="$2"
  return 0
}

# Every call is JSON in and JSON out. Success is the payload under "data";
# failure is a non-2xx with {"error": "..."} and sometimes {"retryable": true}.
# The -f makes curl exit non-zero on a non-2xx, which is what lets the shell
# stop instead of acting on an error body.
api() {
  method="$1"; path="$2"; body="${3:-}"
  if [ -n "$body" ]; then
    curl -fsS -X "$method" "$APPLAB_URL$path" \
      -H "Authorization: Bearer $APPLAB_KEY" \
      -H "Content-Type: application/json" \
      -d "$body"
  else
    curl -fsS -X "$method" "$APPLAB_URL$path" \
      -H "Authorization: Bearer $APPLAB_KEY"
  fi
}

# urlencode makes a value safe to put in a query string.
#
# Commit messages are free text, and a space in one is enough to make curl reject
# the whole URL — which it does by exiting non-zero *before* sending anything, so
# a missing encoding is not a mangled message, it is no message and no upload.
#
# Only the characters a commit message plausibly contains *and* that carry
# meaning in a URL are replaced. Anything else — including every non-ASCII byte
# of a message written in another language — is left as it stands, which is what
# the API expects from a UTF-8 query value.
urlencode() {
  printf '%s' "$1" | sed \
    -e 's/%/%25/g' \
    -e 's/ /%20/g' \
    -e 's/&/%26/g' \
    -e 's/#/%23/g' \
    -e 's/?/%3F/g' \
    -e 's/+/%2B/g' \
    -e 's/=/%3D/g' \
    -e "s/'/%27/g"
}

# json_escape makes a value safe to put inside a JSON string.
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# json_pairs builds {"<wrapper>":{"K":"V",...}} from KEY=VALUE arguments.
#
# The value may contain "=" — a connection string is the common case — so the
# split is on the first one only. A value containing a quote or a backslash is
# escaped rather than refused: a password is exactly the kind of thing that
# contains one, and telling the caller to go and change it would be absurd.
json_pairs() {
  wrapper="$1"; shift
  [ "$#" -gt 0 ] || { echo "expected at least one KEY=VALUE" >&2; return 1; }

  out=""
  for pair in "$@"; do
    key="${pair%%=*}"
    if [ "$key" = "$pair" ]; then
      echo "expected KEY=VALUE, got: $pair" >&2
      return 1
    fi
    out="$out\"$(json_escape "$key")\":\"$(json_escape "${pair#*=}")\","
  done
  printf '{"%s":{%s}}' "$wrapper" "${out%,}"
}

# json_field reads one field out of a JSON response, so the script does not
# depend on jq.
#
# Two forms, because the API returns both: a string value is quoted and a number
# or boolean is not. Matching only the quoted form silently returns nothing for
# `replicas`, which reads as "the app has no replica count" rather than as a
# parse that did not apply.
#
# The input is read once and searched twice rather than piped twice: the caller
# hands it over on stdin, and a second read would find nothing.
json_field() {
  input=$(cat)

  value=$(printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1)
  if [ -z "$value" ]; then
    value=$(printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\([^,}[:space:]]*\).*/\1/p" | head -1)
  fi

  printf '%s' "$value"
}

# branch_list prints the branches from a /branches response, marking the active
# one.
#
# The response is {"app_id":"…","branches":["main","dev"],"active":"main"} and it
# is read with sed rather than parsed, like json_field and for the same reason:
# this script is expected to work over a bare base system with no jq. The array
# is taken as the text between the first "[" and the "]" that closes it, split on
# commas, and each element stripped of its quotes.
#
# The mark matches the console's and the CLI's: the active branch is the one you
# are looking for, and * next to it is a glance rather than a search.
branch_list() {
  input=$(cat)
  active=$(printf '%s' "$input" | json_field active)
  list=$(printf '%s' "$input" | sed -n 's/.*"branches"[: ]*\[\([^]]*\)\].*/\1/p' | head -1)

  if [ -z "$list" ]; then
    echo "this app has no branches yet" >&2
    echo "push to create one: git push <remote> HEAD" >&2
    return 0
  fi

  printf '%s\n' "$list" | tr ',' '\n' | while read -r name; do
    name=$(printf '%s' "$name" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
    [ -n "$name" ] || continue
    if [ "$name" = "$active" ]; then
      echo "* $name"
    else
      echo "  $name"
    fi
  done
}

# The app's own id, so the script works without a key for anything local.
usage() {
  cat <<'EOF'
usage: ./applab.sh <command>

Start here
  create <app>       make a new app, and print its key and clone address
  use <app>          point this script at an app; remembered for next time
  list               the apps on this deployment, one "<id> <address>" per line

  A copy fetched from the deployment has no app in it, so `use` (or `create`) is
  how it gets one. A copy in an app's repository already knows its app, and these
  two are then only needed to work on a different one.

  Fetch a fresh, app-less copy of this script at any time:

    curl -fsS <deployment>/bootstrap/applab.sh -o applab.sh && chmod +x applab.sh

Source
  push [message]     upload this directory, build it and deploy it
  upload [message]   upload this directory without building
  build [commit]     build a commit (default: the newest)
                     --branch <name> builds another branch, without switching
  cancel [build]     stop a build (default: the one in flight)
  deploy [commit]    deploy a commit (default: the newest), building it if needed
                     --branch <name> deploys another branch and switches to it
  rollback <commit>  deploy an earlier commit, reusing its image

Looking
  status             what is running, and where
  url                just the address the app is served at
  git                the clone and push commands for the active branch
  show               the app itself: port, replicas, domain, address
  logs [flags]       the app's log; see "logs" below for --pod and --previous
  build-logs [build] a build's output (default: the newest build)
  events             recent Kubernetes events — why a pod never started
  pods               the pods, and why one is not ready
  diagnose           why the app is not working, if it is not
  history            the commit history
  builds             the build history
  config             environment variables, and the names of the secrets

Changing
  replicas [n]       how many copies to run (no argument: print the current one)
  resources          what each pod is using, and the bounds it runs under
  resources set K=V  set cpu/memory request and limit, e.g. memory_limit=512Mi
                     (an empty value clears it back to the deployment default)
  env set K=V ...    set environment variables
  env unset K ...    remove environment variables
  secret set K=V ... set secret values
  secret unset K ... remove secrets
  restart            roll the pods, keeping the same image
  stop               remove the running app, keeping the source
  delete <app>       delete the app and its history (needs an admin key)

Other deployments
  servers            the AppLab deployments this one can reach (needs an admin key)
  servers-add <id> <address>
                     register another deployment; key from APPLAB_SERVER_KEY
  servers-remove <id>
                     forget a registration; the remote is untouched

  Once registered, point a command at one with --server, before its own argument:

    ./applab.sh list --server lab-2
    ./applab.sh create --server lab-2 shop
    ./applab.sh delete --server lab-2 shop

  The request is relayed by this deployment, which holds the remote's key — the
  key itself never leaves it. "local" is this deployment, and is always reachable
  without --server at all.

Branches
  branch             the branches this app has, and which one is running
  branch use <name>  switch to a branch and deploy it

  A branch is created by pushing to it — git's own rule. Switching replaces what
  is running: one app runs one branch at a time.

  Run "./applab.sh git" for the exact clone and push commands, with this
  deployment's host and this app's branch already in them. The shape is:

  git clone "https://x:$APPLAB_KEY@<host>/git/<app>.git"        the active branch
  git clone "https://x:$APPLAB_KEY@<host>/git/<app>@dev.git"    the branch dev
  git push  "https://x:$APPLAB_KEY@<host>/git/<app>@dev.git" HEAD:dev

  The active branch is the one the plain address gives you; naming a branch is
  what clones or pushes a different one. See AGENT.md for more.

Debugging
  logs               the newest pod's log, which is usually the one you want
  logs --pod <name>  one pod's log, by name from "pods"
  logs --previous    the previous container instance — where a crash loop's
                     reason is written, since the current one is only restarting
  logs -f            follow it as it arrives
  build-logs         the newest build's output, where a failed build is explained
  build-logs <id>    one build's output, by id from "builds"
  events             what the cluster says went wrong: a failed scheduling, an
                     image pull that was refused, a probe that killed a container
  diagnose           all of the above, ordered so the most likely cause is first

  Start with "diagnose". It answers "why is this not working" in one call, and
  the commands above are what to reach for when its answer needs more detail.

Keys and upkeep
  key                print this app's key
  self-update        fetch the current applab.sh and AGENT.md from the deployment
  help               this

  Every command except this one and "self-update" refreshes applab.sh and
  AGENT.md from the deployment first, and re-runs itself if either had changed.
  That is what keeps a checkout that has not been pushed in a while working
  against a deployment whose API has moved on. Set APPLAB_NO_REFRESH=1 to skip
  it.

Environment:
  APPLAB_URL   the deployment              (default: built into this script)
  APPLAB_KEY   the key for this app        (default: built into this script)
  APPLAB_SERVER_KEY   an admin key for a remote, for servers-add
  APPLAB_NO_REFRESH   set to 1 to skip the refresh above

  Both are defaults — the values below the APP assignment. Export either to
  override it, which is what working against another deployment, or with a key
  you rotated, takes.
EOF
}

# where prints the address the app is served at.
#
# It reads the app rather than the status: the address is a fact about the app's
# settings, known from the moment it exists, where the status is what the cluster
# has. An app that has never been deployed has an address and nothing answering
# at it, and this is the command that says which.
where() {
  api GET "/api/v1/apps/$APP" | json_field url
}

# branch_query renders the branch half of a query string.
#
# Empty when no branch was named, which is not the same as naming one: the API
# reads an absent parameter as "the app's active branch", so a command with no
# --branch does what it always did rather than failing on a branch named "".
branch_query() {
  [ -n "${1:-}" ] || return 0
  printf '?branch=%s' "$(urlencode "$1")"
}

# push packages this directory the way AppLab expects.
#
# The exclusions are the ones that would make an upload slower and a build no
# more correct: build output, dependencies and the git directory itself. A
# .gitignore is honoured by nothing here — the archive *is* the statement of what
# to store, so what is listed is what lands.
package() {
  tar czf - \
    --exclude=./.git \
    --exclude=./node_modules \
    --exclude=./target \
    --exclude=./.venv \
    --exclude=./__pycache__ \
    --exclude=./applab.sh \
    --exclude=./AGENT.md \
    .
}

upload() {
  message="$(urlencode "${1:-upload from applab.sh}")"

  # The response is captured first and the commit extracted from it, rather than
  # piping curl into json_field. Piping hides curl's exit status — a pipeline
  # reports the last command's, and json_field succeeds on empty input — so a
  # refused upload would return an empty commit and the caller would carry on to
  # build nothing. Assigning from a command substitution is not exempt from a
  # failure either: the assignment has to be checked, which `if !` does.
  #
  # -sS with -o and -w rather than -f, because the status has to be readable:
  # -f turns any refusal into a bare non-zero exit, and the one refusal with a
  # different remedy — 413, over the deployment's single-request limit — would
  # be indistinguishable from a bad key or a dead server.
  out="$(mktemp "${TMPDIR:-/tmp}/applab-upload.XXXXXX")" || return 1
  status=$(package | curl -sS -o "$out" -w '%{http_code}' -X POST \
    "$APPLAB_URL/api/v1/apps/$APP/source?message=$message" \
    -H "Authorization: Bearer $APPLAB_KEY" \
    -H "Content-Type: application/gzip" \
    --data-binary @-) || {
    rm -f "$out"
    echo "could not reach $APPLAB_URL to upload" >&2
    return 1
  }

  case "$status" in
    200|201) response="$(cat "$out")" ;;
    413)
      # The archive is over the size this deployment accepts in one request, and
      # it says so with the number and a way through. Now the way through: the
      # same archive sent as parts through /source/uploads.
      #
      # Rebuilt rather than reused, and this is the part worth knowing. `package`
      # writes into a pipe that curl has already read part of, and a pipe cannot
      # be rewound — so what is left of it is the tail of a tar, not an archive.
      # The tree is unchanged, so running tar again produces the same bytes.
      response="$(upload_in_parts "${1:-upload from applab.sh}")" || {
        rm -f "$out"
        return 1
      }
      ;;
    *)
      echo "upload refused ($status): $(cat "$out")" >&2
      rm -f "$out"
      return 1
      ;;
  esac
  rm -f "$out"

  sha=$(printf '%s' "$response" | json_field commit_sha)
  if [ -z "$sha" ]; then
    echo "the upload was accepted but named no commit: $response" >&2
    return 1
  fi
  printf '%s' "$sha"
}

# upload_in_parts sends this directory's archive through the chunked endpoints.
#
# The fallback for a tree over the single-request limit. It needs two tools the
# rest of this script does not, both of which every POSIX system ships:
#
#     mktemp          staging the archive, because it has to be measured
#     dd, wc          cutting it into parts, and finding out how many
#
# The archive is spooled to a file rather than streamed, which is the whole
# difference from the one-request path: the protocol is told how many parts to
# expect before the first arrives, so the length has to be known up front, and a
# piped tar cannot be measured without being read. That trades the streaming for
# a temp file the size of the archive, which is the price of the fallback
# existing at all — and it is only paid by a tree large enough to need it.
upload_in_parts() {
  raw_message="$1"

  # The body runs in an explicit subshell so its EXIT trap is scoped to it. A
  # trap set inside a function otherwise outlives the function and fires when the
  # whole script ends — which after a `push` is minutes later, once the build has
  # finished, leaving the staged archive on disk for the length of that wait. The
  # caller uses a command substitution, which is a subshell too, but saying so
  # here means the cleanup does not depend on how it happens to be called.
  (
    archive="$(mktemp "${TMPDIR:-/tmp}/applab-source.XXXXXX")" || exit 1
    trap 'rm -f "$archive"' EXIT HUP INT TERM

    if ! package > "$archive"; then
      echo "could not package this directory" >&2
      exit 1
    fi

    # The deployment's own part size, so a client and a server agree on what a
    # part is without this script hardcoding a number that drifts from the
    # config.
    chunk=$(api GET /api/v1/config | json_field chunk_size)
    case "$chunk" in '' | *[!0-9]*) chunk=8388608 ;; esac

    size=$(wc -c < "$archive" | tr -d ' ')
    count=$(( (size + chunk - 1) / chunk ))
    if [ "$count" -lt 1 ]; then
      echo "there is nothing to upload" >&2
      exit 1
    fi
    echo "uploading $count parts of $chunk bytes" >&2

    begin=$(api POST "/api/v1/apps/$APP/source/uploads" \
      "{\"total\":$count,\"chunk_size\":$chunk,\"message\":\"$(json_escape "$raw_message")\"}") || exit 1
    upload_id=$(printf '%s' "$begin" | json_field upload_id)
    if [ -z "$upload_id" ]; then
      echo "the deployment did not accept the upload: $begin" >&2
      exit 1
    fi

    i=1
    while [ "$i" -le "$count" ]; do
      # One part at a time, cut by dd rather than by `split`: dd is the same tool
      # on every base system and needs no directory to write parts into.
      if ! dd if="$archive" bs="$chunk" skip=$((i - 1)) count=1 2>/dev/null \
        | curl -fsS -X PUT "$APPLAB_URL/api/v1/apps/$APP/source/uploads/$upload_id/parts/$i" \
          -H "Authorization: Bearer $APPLAB_KEY" \
          -H "Content-Type: application/octet-stream" \
          --data-binary @- >/dev/null; then
        echo "part $i of $count failed" >&2
        exit 1
      fi
      i=$((i + 1))
    done

    # The commit is stored here, not at the parts: assembling and committing are
    # one step on the server, so a part that never arrives leaves nothing behind.
    api POST "/api/v1/apps/$APP/source/uploads/$upload_id/complete" || exit 1
  )
}

# self-update replaces this script and AGENT.md with the deployment's current
# copies.
#
# AppLab's API changes between releases, and these files are written into the
# repository on every upload — so a checkout that has not been pushed in a while
# carries a script that may call an endpoint that no longer exists. Fetching the
# current version from the running server is what makes that recoverable without
# a push, and it is the same content the next upload would write anyway.
#
# The script is self-modifying, and it is the only file it could mean — but the
# directory it writes to is the one the script lives in, not the one the caller
# happens to be standing in. `../applab.sh self-update` from a subdirectory must
# replace the script, not drop a second copy into the subdirectory.
#
# Each file is written to a temporary and then moved, so an interrupted or failed
# download cannot leave a half-written script where a working one was.
#
# No argument updates both files, and prints what it did — that is the `self-update`
# command. An argument picks one file and says whether it changed, on *stdout*,
# which is what the refresh below reads as its signal; the messages the no-argument
# form prints go to stderr, because they are progress rather than output.
#
# The script's own file is replaced last and by a move, so a run of the refresh
# is never a half-updated pair: either both files are current or neither was
# touched.
# looks_like reports whether a downloaded file is plausibly the file asked for.
#
# Deliberately cheap and shallow — it cannot verify the content, only reject the
# things that are obviously not it. JSON and HTML are the two a proxy produces,
# and each is recognisable by its first character; a shell script is recognisable
# by its shebang. A file that passes this and is still wrong is a server
# serving the wrong *script*, which no check here could catch.
looks_like() {
  case "$1" in
    applab.sh)
      # `head -c 2` rather than the whole file: this runs before every command.
      [ "$(head -c 2 "$2" 2>/dev/null)" = "#!" ]
      ;;
    *)
      # A markdown document. Rejected if it opens like a JSON body or an HTML
      # document, which are the two ways a routing mistake presents itself.
      first=$(head -c 1 "$2" 2>/dev/null)
      [ "$first" != "{" ] && [ "$first" != "<" ]
      ;;
  esac
}

self_update() {
  only="${1:-}"
  dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

  for name in applab.sh AGENT.md; do
    if [ -n "$only" ] && [ "$name" != "$only" ]; then
      continue
    fi

    url="$APPLAB_URL/api/v1/apps/$APP/agent/files/$name"
    tmp="$dir/$name.applab-new"

    if ! curl -fsS -H "Authorization: Bearer $APPLAB_KEY" "$url" -o "$tmp"; then
      rm -f "$tmp"
      if [ -n "$only" ]; then
        return 1
      fi
      echo "could not fetch $name from $url" >&2
      return 1
    fi
    # What came back has to look like the file it would replace. A non-empty
    # check is not enough: a proxy that answers a 200 with an HTML error page, or
    # a misrouted path that returns JSON, replaces a working script with
    # something that cannot run — and the failure appears on the *next* command,
    # which now cannot parse its own body. "Nothing was replaced" is always
    # better than that, since the caller still has a script that works.
    if ! looks_like "$name" "$tmp"; then
      rm -f "$tmp"
      if [ -n "$only" ]; then
        return 1
      fi
      echo "$name did not come back as $name; nothing was replaced" >&2
      return 1
    fi

    # Comparing before replacing is what makes the no-argument refresh cheap to
    # run before every command: an unchanged file is not rewritten, so its
    # mtime does not move and nothing is printed.
    if [ -f "$dir/$name" ] && cmp -s "$tmp" "$dir/$name"; then
      rm -f "$tmp"
      continue
    fi

    if [ "$name" = "applab.sh" ]; then
      chmod +x "$tmp"
    fi
    mv "$tmp" "$dir/$name"

    if [ -n "$only" ]; then
      echo "updated $dir/$name"
    else
      echo "updated $dir/$name" >&2
    fi
  done
}

# refresh re-runs this command from the deployment's current copy of the script.
#
# It is the whole of the "keep yourself current" behaviour: fetch, compare, and
# if the copy in the checkout is not the deployment's, replace it and re-exec.
#
# Re-exec rather than fetching and continuing, because the running shell is the
# old script and cannot become the new one — the command that was typed has to be
# interpreted by the version it was typed against. `exec` keeps the exit status
# and the terminal, so the caller sees one command's output and not two.
#
# Every failure here is non-fatal and silent, which is the point: this runs before
# `status`, before `logs -f`, before a push into an air-gapped network. A
# deployment that is unreachable, a key that was rotated, a directory that is not
# writable — none of those are reasons for the command the caller actually asked
# for to fail, and the local copy is what they were working with a moment ago.
#
# The recursion is bounded by the comparison: the second run finds the file it
# just wrote to be identical and does not re-exec again. APPLAB_REFRESHED stops it
# even if the comparison cannot — a server that renders the script differently on
# every read would otherwise be an infinite loop of processes.
refresh() {
  [ "${APPLAB_NO_REFRESH:-}" = "1" ] && return 0
  [ "${APPLAB_REFRESHED:-}" = "1" ] && return 0

  # Nothing to refresh against without an app: the files are served per app, and
  # a bootstrap copy has none yet. Asked anyway, it would be a request that
  # cannot succeed on every command — the failure is swallowed, but a request
  # that is known to be useless should not be made.
  [ -n "$APP" ] || return 0

  changed=$(self_update applab.sh 2>/dev/null) || return 0
  [ -n "$changed" ] || return 0

  self_update AGENT.md >/dev/null 2>&1 || true

  echo "$changed" >&2
  echo "re-running $1 with the current applab.sh" >&2
  APPLAB_REFRESHED=1 exec "$0" "$@"
}

# require_app_matches guards the one command that is not about a single app.
#
# `delete` takes the id as an argument because it is irreversible and the id has
# to come from the caller rather than from a file the caller may not have read.
# Checking it against APP is what stops the wrong one being deleted by a script
# run from the wrong directory.
require_app_matches() {
  [ "$1" = "$APP" ] || {
    echo "this repository is $APP, not $1" >&2
    echo "delete names the app explicitly because there is no undo" >&2
    exit 2
  }
}

# Bring this checkout up to the deployment's current script before doing anything
# — see refresh. `help` is exempt because it documents the copy in hand, and
# `self-update` because it does this itself and would otherwise do it twice.
case "${1:-help}" in
  help|-h|--help|self-update) ;;
  *) refresh "${1:-help}" "$@" ;;
esac

# Every command but these four is about one app, and a copy fetched from the
# bootstrap route does not know which. Checked here rather than inside each arm
# so that the list of exceptions is one line a reader can check against the
# usage, and so a command added later fails loudly instead of asking the
# deployment about an app named "".
case "${1:-help}" in
  help|-h|--help|self-update|create|use|list|servers|servers-add|servers-remove) ;;
  *) require_app ;;
esac

case "${1:-help}" in
  push)
    shift
    sha=$(upload "${1:-push from applab.sh}")
    echo "committed $sha" >&2
    api POST "/api/v1/apps/$APP/builds" "{\"commit_sha\":\"$sha\"}" >/dev/null
    echo "building; the first build has no cache and takes a while" >&2
    # A build is a Job, so it is polled rather than waited on by the API. The
    # loop is bounded so a wedged build fails here instead of hanging forever.
    i=0
    while [ "$i" -lt 180 ]; do
      state=$(api GET "/api/v1/apps/$APP/builds/$sha" | json_field status)
      case "$state" in
        succeeded) break ;;
        failed|build-failed) echo "build failed; see: ./applab.sh builds" >&2; exit 1 ;;
      esac
      i=$((i + 1)); sleep 5
    done
    api POST "/api/v1/apps/$APP/deploy" "{\"commit_sha\":\"$sha\"}" | json_field url
    ;;
  upload)
    shift
    upload "$@"
    ;;
  build)
    shift
    # Flags rather than a positional, because the argument is a commit and
    # --branch is not one. The branch is what the picker on the console's State
    # card sends, and leaving it out builds the app's active branch — which is
    # what most callers mean and what this did before there was a choice.
    build_branch=""
    build_commit=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --branch)
          shift
          [ -n "${1:-}" ] || { echo "--branch needs a name; see ./applab.sh branch" >&2; exit 2; }
          build_branch="$1"
          ;;
        *)
          build_commit="$1"
          ;;
      esac
      shift
    done
    api POST "/api/v1/apps/$APP/builds$(branch_query "$build_branch")" \
      "{\"commit_sha\":\"$(json_escape "$build_commit")\"}"
    ;;
  cancel)
    shift
    # The build to stop: one named on the command line, or whatever is in flight.
    # Naming it is how a specific build is stopped; naming nothing is what someone
    # means after a push has gone wrong, which is "stop what you are doing".
    if [ -n "${1:-}" ]; then
      id="$1"
    else
      # The newest build that has not finished. `builds` is newest first, so the
      # first non-terminal status in the list is the one running. json_field reads
      # one field per call and the list is a single line per build, so this walks
      # the ids and statuses together rather than parsing the array.
      listing=$(api GET "/api/v1/apps/$APP/builds?limit=20")
      id=$(printf '%s' "$listing" | tr '{' '\n' | grep -v '"status":"succeeded"' \
        | grep -v '"status":"failed"' | grep -v '"status":"cancelled"' \
        | sed -n 's/.*"id":"\([^"]*\)".*/\1/p' | head -1)
    fi

    [ -n "$id" ] || { echo "nothing is building" >&2; exit 0; }
    api DELETE "/api/v1/apps/$APP/builds/$id" | json_field status
    echo
    echo "stopped $id" >&2
    ;;
  deploy)
    shift
    # build:true so this does not refuse for the one reason that would make it
    # useless — a commit uploaded but not yet built. A commit that already has an
    # image reuses it, so the common case is not a rebuild. This is what the
    # console's "Deploy latest" does, and the two have to agree.
    deploy_branch=""
    deploy_commit=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --branch)
          shift
          [ -n "${1:-}" ] || { echo "--branch needs a name; see ./applab.sh branch" >&2; exit 2; }
          deploy_branch="$1"
          ;;
        *)
          deploy_commit="$1"
          ;;
      esac
      shift
    done

    # Another branch is a switch, not a deploy: an app runs one branch, and
    # POST /deploy?branch= deliberately deploys a branch *without* recording it.
    # That is right for a caller checking one out and wrong here, where choosing
    # a branch and pressing deploy means "run this one" — the app would otherwise
    # serve dev while reporting main, and the clone address, the history and the
    # branch auto-deploy builds would all name the other one. The console does
    # the same thing for the same reason.
    if [ -n "$deploy_branch" ]; then
      active=$(api GET "/api/v1/apps/$APP/branches" | json_field active)
      if [ "$deploy_branch" != "$active" ]; then
        api PUT "/api/v1/apps/$APP/branch" "{\"branch\":\"$(json_escape "$deploy_branch")\"}"
        exit 0
      fi
    fi

    api POST "/api/v1/apps/$APP/deploy$(branch_query "$deploy_branch")" \
      "{\"commit_sha\":\"$(json_escape "$deploy_commit")\",\"build\":true}"
    ;;
  rollback)
    shift
    [ -n "${1:-}" ] || { echo "rollback needs a commit; see ./applab.sh history" >&2; exit 2; }
    api POST "/api/v1/apps/$APP/rollback" "{\"commit_sha\":\"$1\"}"
    ;;
  status)
    api GET "/api/v1/apps/$APP/status"
    ;;
  logs)
    shift
    # Flags rather than positionals: a pod name is a string and "-f" is not a
    # pod, so the two cannot share a slot without the script guessing which one
    # it was handed.
    follow=false
    pod=""
    previous=false
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -f|--follow) follow=true ;;
        --pod)
          shift
          [ -n "${1:-}" ] || { echo "--pod needs a pod name; see ./applab.sh pods" >&2; exit 2; }
          pod="$1"
          ;;
        --previous) previous=true ;;
        *)
          echo "unknown flag for logs: $1 (see ./applab.sh help)" >&2
          exit 2
          ;;
      esac
      shift
    done

    path="/api/v1/apps/$APP/logs?follow=$follow&tail=500&previous=$previous"
    # The pod is named only when one was given. Sending pod= empty would ask the
    # server for a pod whose name is the empty string, which it refuses, rather
    # than for the newest one — which is what no pod means.
    [ -n "$pod" ] && path="$path&pod=$(urlencode "$pod")"
    api GET "$path"
    ;;

  build-logs)
    shift
    # The newest build unless one is named, which is what someone who has just
    # watched a push fail means by it. An id from "builds" names a specific one.
    build="${1:-}"
    if [ -z "$build" ]; then
      build=$(api GET "/api/v1/apps/$APP/builds?limit=1" | json_field id)
      [ -n "$build" ] || { echo "this app has no builds yet" >&2; exit 1; }
    fi
    api GET "/api/v1/apps/$APP/builds/$build/logs?follow=false"
    ;;

  events)
    api GET "/api/v1/apps/$APP/events?limit=50"
    ;;
  diagnose)
    api GET "/api/v1/apps/$APP/diagnose"
    ;;
  history)
    api GET "/api/v1/apps/$APP/commits?limit=50"
    ;;
  builds)
    api GET "/api/v1/apps/$APP/builds?limit=20"
    ;;
  create)
    # Make a new app and print what to do with it.
    #
    # Needs an admin key, which is why it is the one command a caller with *no*
    # key is told to run: its refusal names the thing they are missing, and the
    # alternative is a script that cannot explain itself until they have already
    # found a way in.
    #
    # Only creates. It does not build or deploy — an app with no source has
    # nothing to build, and the platform's own auto-publish covers the case
    # where one appears. `push` is what ships code.
    shift
    # --server, if given, must come first: it is how a caller says "create this
    # on another deployment". Only the id goes to "create" — the server is a
    # property of the request, not part of the app's name.
    if take_server "$@"; then
      shift 2
    fi
    [ -n "${1:-}" ] || { echo "usage: $0 create [--server <id>] <app>" >&2; exit 2; }
    require_key
    new="${1}"

    created=$(api POST "$(app_path)" "{\"id\":\"$(json_escape "$new")\"}") || exit 1

    echo "created $new" >&2
    # The clone address with the key in it, straight from the API — it knows the
    # deployment's host and the new app's branch, and a caller assembling one
    # gets the branch wrong for anything but the default. On a remote this is the
    # remote's own address, which is exactly where the app is.
    key=$(printf '%s' "$created" | json_field app_key)
    clone=$(printf '%s' "$created" | json_field git_url_with_key)
    where=$(printf '%s' "$created" | json_field url)

    printf '%s\n' "$key"
    [ -n "$clone" ] && echo "git clone $clone" >&2
    [ -n "$where" ] && echo "served at $where" >&2

    # A remote app is not this checkout's app: `push`, `status` and the rest are
    # about the app this repository is, and the relay reaches a remote only for
    # listing, creating and deleting. Binding APP here would make the next
    # command talk about a remote app as though it were local, so the pointer and
    # the push suggestion are for the local case only.
    if [ -n "$APPLAB_SERVER" ]; then
      echo >&2
      echo "$new lives on $APPLAB_SERVER; manage it with: $0 list --server $APPLAB_SERVER" >&2
      exit 0
    fi

    # Bound for the rest of this process, and remembered for the next one, so
    # `create shop && push` works in one line.
    APP="$new"
    printf '%s' "$new" > "$APPLAB_STATE" 2>/dev/null || true
    echo >&2
    echo "now: $0 push  (or the git clone above)" >&2
    ;;
  use)
    # Point this copy of the script at an app.
    #
    # Written to a file beside the script rather than exported, because the
    # script is invoked fresh each time and a plain export would not survive.
    shift
    [ -n "${1:-}" ] || { echo "usage: $0 use <app>" >&2; exit 2; }
    require_key

    # Checked before it is remembered: a typo that is silently stored would make
    # every later command fail with something about an app that does not exist.
    #
    # curl's own message is suppressed and replaced. It reports the status, which
    # is the one thing the reader already knows; what they need is that an app by
    # that name does not exist here.
    api GET "/api/v1/apps/$1" >/dev/null 2>&1 || {
      echo "no app named $1 on this deployment" >&2
      exit 1
    }

    APP="$1"
    printf '%s' "$APP" > "$APPLAB_STATE"
    echo "now using $APP" >&2
    ;;
  url)
    where
    ;;
  git)
    # The clone address the API reports, with this app's key already in it — the
    # same field the console and the CLI read, so the branch is right here too.
    #
    # This script used to print the address with a literal <host> in it, and
    # always with the app's bare name: an app on a non-default branch is cloned
    # from /git/<app>@<branch>.git, so what it printed was a command that cloned
    # a different tree than the one running.
    #
    # Reported by the deployment rather than assembled here for the same reason:
    # the host, the /git mount and the branch convention are three things this
    # script should not be the fourth implementation of.
    clone=$(api GET "/api/v1/apps/$APP/key" | json_field git_url_with_key)

    if [ -z "$clone" ]; then
      echo "this deployment does not report a clone address; it may not know" >&2
      echo "its own public URL, in which case there is no address to print" >&2
      exit 1
    fi

    echo "git clone $clone"
    ;;
  show)
    api GET "/api/v1/apps/$APP"
    ;;
  pods)
    api GET "/api/v1/apps/$APP/pods"
    ;;
  config)
    api GET "/api/v1/apps/$APP/config"
    ;;
  replicas)
    shift
    if [ "$#" -eq 0 ]; then
      # No argument reads, which is the other half of what someone wants from a
      # setting: the value is in `show` too, but this is the one they will reach
      # for after setting it. `exit` rather than `break` — this is a case arm,
      # not a loop, and `break` here would fall through to the argument handling
      # below and read an argument that was never given.
      api GET "/api/v1/apps/$APP" | json_field replicas
      exit 0
    fi
    # The range is checked here as well as on the server, the same way the
    # console checks it: the server's answer is a 400 naming a parameter, and
    # "between 1 and 50" is the answer that tells the caller what to do.
    case "$1" in
      ''|*[!0-9]*) echo "replicas takes a whole number" >&2; exit 2 ;;
    esac
    if [ "$1" -lt 1 ] || [ "$1" -gt 50 ]; then
      echo "replicas must be between 1 and 50" >&2
      exit 2
    fi
    api PATCH "/api/v1/apps/$APP" "{\"replicas\":$1}" | json_field replicas
    echo
    echo "set; it takes effect on the next deploy" >&2
    ;;
  resources)
    shift
    case "${1:-}" in
      '')
        # No argument reads, and the reading is the point of the command: usage
        # comes from the cluster's metrics API, and the bounds beside it are the
        # effective ones — the app's settings with this deployment's defaults
        # already resolved onto the fields the app left empty.
        api GET "/api/v1/apps/$APP/resources"
        ;;
      set)
        shift
        [ "$#" -gt 0 ] || { echo "resources set takes at least one key=value" >&2; exit 2; }
        body=""
        for pair in "$@"; do
          name="${pair%%=*}"
          if [ "$name" = "$pair" ]; then
            echo "expected KEY=VALUE, got: $pair" >&2
            exit 2
          fi
          # The four names are the API's own field names rather than a shorter
          # spelling of them: a mapping between two vocabularies is a place for
          # them to drift, and underscores are as easy to type as anything else.
          case "$name" in
            cpu_request|cpu_limit|memory_request|memory_limit) ;;
            *) echo "unknown resource: $name (cpu_request, cpu_limit, memory_request, memory_limit)" >&2; exit 2 ;;
          esac
          [ -n "$body" ] && body="$body,"
          body="$body\"$name\":\"$(json_escape "${pair#*=}")\""
        done
        api PATCH "/api/v1/apps/$APP" "{\"resources\":{$body}}"
        echo
        echo "set; it takes effect on the next deploy" >&2
        ;;
      *)
        echo "resources takes no argument to read, or: resources set K=V ..." >&2
        exit 2
        ;;
    esac
    ;;
  env)
    shift
    case "${1:-}" in
      set)
        shift
        api PUT "/api/v1/apps/$APP/env" "$(json_pairs env "$@")"
        ;;
      unset)
        shift
        for name in "$@"; do
          api DELETE "/api/v1/apps/$APP/env/$(urlencode "$name")" >/dev/null
          echo "removed $name" >&2
        done
        ;;
      *)
        echo "usage: ./applab.sh env set K=V ... | env unset K ..." >&2
        exit 2
        ;;
    esac
    ;;
  secret)
    shift
    case "${1:-}" in
      set)
        shift
        api PUT "/api/v1/apps/$APP/secrets" "$(json_pairs secrets "$@")"
        ;;
      unset)
        shift
        for name in "$@"; do
          api DELETE "/api/v1/apps/$APP/secrets/$(urlencode "$name")" >/dev/null
          echo "removed $name" >&2
        done
        ;;
      *)
        echo "usage: ./applab.sh secret set K=V ... | secret unset K ..." >&2
        exit 2
        ;;
    esac
    ;;
  branch)
    shift
    if [ "${1:-}" = "use" ]; then
      shift
      [ -n "${1:-}" ] || { echo "usage: ./applab.sh branch use <branch>" >&2; exit 2; }
      # Escaped rather than interpolated bare: git allows a `"` in a ref name, so
      # a caller can reach here with one, and unescaped it would end the string
      # and make the request malformed. Whether the name is otherwise acceptable
      # is the server's answer, not this script's.
      api PUT "/api/v1/apps/$APP/branch" \
        "{\"branch\":\"$(json_escape "$1")\"}" >/dev/null
      # Reported as building rather than as deployed: the switch deploys the
      # branch's tip, and a branch that was just pushed has no image yet, so the
      # common case is a build. Saying "deployed" would have the caller expecting
      # to find it serving.
      echo "switched to $1; see ./applab.sh status" >&2
      exit 0
    fi
    api GET "/api/v1/apps/$APP/branches" | branch_list
    ;;
  restart)
    api POST "/api/v1/apps/$APP/restart" >/dev/null
    echo "rolling the pods" >&2
    ;;
  stop)
    api POST "/api/v1/apps/$APP/stop" >/dev/null
    echo "stopped; the source and history are kept, so a deploy brings it back" >&2
    ;;
  delete)
    shift
    # --server first, like create: this deletes the named app on the named
    # deployment, and the self-check below does not apply to a remote — this
    # script lives in *this* app's repository and has no business knowing
    # whether a remote app of the same name is the one intended.
    if take_server "$@"; then
      shift 2
    fi
    [ -n "${1:-}" ] || { echo "usage: ./applab.sh delete [--server <id>] <app>" >&2; exit 2; }
    if [ -z "$APPLAB_SERVER" ]; then
      require_app_matches "$1"
    fi
    # Typed out rather than confirmed, for the same reason the console makes you
    # type it: this removes the source, the history and the running app, and
    # there is nothing to undo it with. A `y` at a prompt is one keystroke from a
    # mistyped command.
    printf 'This deletes %s, its source and its history, with no undo.\nType the app id to confirm: ' "$1" >&2
    read -r typed
    [ "$typed" = "$1" ] || { echo "not deleted" >&2; exit 1; }
    api DELETE "$(app_path)/$(json_escape "$1")" >/dev/null
    echo "deleted $1" >&2
    ;;
  list|ls)
    # The apps on a deployment, or on a remote with --server. The id and address
    # are the two fields worth a line each; anything more and this becomes the
    # console, which is not what a shell is for.
    shift
    if take_server "$@"; then
      shift 2
    fi
    require_key
    # One line per app, "id<TAB>address", so a caller can pipe it. Records are
    # split on "},{" — the boundary between two array elements — rather than on a
    # lone "}", because an app's own body is nested (resources is an object) and
    # splitting on every brace would tear a record in half. The address is read
    # with sed rather than parsed, like everything else here; see json_field.
    api GET "$(app_path)" | sed 's/},{/}\n{/g' | while IFS= read -r record; do
      id=$(printf '%s' "$record" | json_field id)
      [ -n "$id" ] || continue
      url=$(printf '%s' "$record" | json_field url)
      printf '%s\t%s\n' "$id" "${url:-}"
    done
    ;;
  servers)
    # The AppLab deployments this one can reach: the built-in "local" first, then
    # each registered remote. Needs an admin key — a server is managed with the
    # platform's own key, not an app's.
    shift
    require_key
    api GET "/api/v1/servers" | sed 's/},{/}\n{/g' | while IFS= read -r record; do
      id=$(printf '%s' "$record" | json_field id)
      [ -n "$id" ] || continue
      url=$(printf '%s' "$record" | json_field url)
      printf '%s\t%s\n' "$id" "${url:-}"
    done
    ;;
  servers-add)
    # Register another deployment by its address and an admin key. The address
    # must include any path prefix that deployment is served under, and the key
    # comes from APPLAB_SERVER_KEY so it is not left in the shell's history.
    shift
    [ -n "${1:-}" ] || { echo "usage: $0 servers-add <id> <address>   (key from APPLAB_SERVER_KEY)" >&2; exit 2; }
    [ -n "${2:-}" ] || { echo "usage: $0 servers-add <id> <address>   (key from APPLAB_SERVER_KEY)" >&2; exit 2; }
    require_key
    [ -n "${APPLAB_SERVER_KEY:-}" ] || {
      echo "servers-add needs an admin key for the remote: export APPLAB_SERVER_KEY=<key>" >&2
      exit 2
    }
    api POST "/api/v1/servers" \
      "{\"id\":\"$(json_escape "$1")\",\"url\":\"$(json_escape "$2")\",\"key\":\"$(json_escape "$APPLAB_SERVER_KEY")\"}" >/dev/null
    echo "registered $1 at $2" >&2
    echo "manage its apps with: $0 list --server $1" >&2
    ;;
  servers-remove)
    # Forget a registration here. The remote and its apps are untouched, and the
    # remote does not need to be reachable — so there is no confirmation prompt:
    # nothing is destroyed and the entry can be added again.
    shift
    [ -n "${1:-}" ] || { echo "usage: $0 servers-remove <id>" >&2; exit 2; }
    require_key
    api DELETE "/api/v1/servers/$(json_escape "$1")" >/dev/null
    echo "removed $1" >&2
    ;;
  key)
    api GET "/api/v1/apps/$APP/key" | json_field key
    ;;
  self-update)
    self_update
    echo "the current version is now in place; every command refreshes it first anyway" >&2
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
