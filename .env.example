# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# An optional YAML file of the same settings, as an alternative to a long
# environment block. Precedence, lowest to highest: built-in defaults, this
# file, then the environment — so anything set below overrides the file.
# APPLAB_CONFIG=/etc/applab/config.yaml

# Address the HTTP server binds. The port must match the container port and the
# Service target in the Helm chart.
APPLAB_LISTEN=:80

# The address this deployment is reached at *from inside the cluster*: the
# Service a build pod clones its source from. It is set by the Helm chart to
# http://applab.<namespace>.svc:80<basePath> and is deliberately not the public
# address — a build pod cannot resolve, and should not depend on, whatever DNS a
# person uses.
#
# It is the whole address, path included: with APPLAB_BASE_PATH=/applab below,
# this is http://applab.ops-system.svc:80/applab.
# APPLAB_BASE_URL=http://applab.ops-system.svc:80

# The address *people* reach this deployment at. Only its scheme is used: it
# decides whether an app's address is handed back as http or https, so an
# installation served over TLS reports https://shop.example.com rather than the
# http the in-cluster address above would imply.
#
# Leave it empty to fall back to the request — its TLS state, then
# X-Forwarded-Proto — which is right for a deployment reached directly and an
# assumption for one behind a proxy that sets neither.
# APPLAB_PUBLIC_URL=https://applab.example.com/applab

# The path this deployment is served under, when it is not the root. Leave empty
# for the root, which is what a deployment at its own hostname wants.
#
# It is the address of the whole installation: the console, the API, git and the
# apps all live under it. With APPLAB_PATH_PREFIX=/apps below, an app called
# "shop" is served at "<host>/applab/apps/shop" — the apps are nested inside it
# rather than beside it.
#
# It exists because of how a Kubernetes Ingress works: an Ingress routes on a
# path but cannot strip one, so a deployment served at /applab receives
# /applab/api/v1/... and the server has to expect the prefix rather than receive
# it stripped. The Helm chart sets this from `ingress.path`, which defaults to
# /applab — set both together, or the Ingress sends a prefix the server is not
# looking for and every request 404s.
#
# "/" and empty both mean the root.
# APPLAB_BASE_PATH=/applab

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# The keys this deployment accepts. These are *admin* keys: a key that
# authenticates may do anything, including delete every app this installation
# manages.
#
# Every app additionally gets a key of its own, created by AppLab when the app is
# created and kept in the object store under the app's own directory. An app key
# reaches only that app — it can push, build, deploy and roll back, but cannot
# delete it — so it is what to give whoever deploys an app. Nothing here
# configures them, and they need no cluster.
#
# APPLAB_KEY takes one key; APPLAB_KEYS takes a comma-separated list. Both are
# merged, so a deployment can carry several — but one is enough, and a second key
# is a second credential to lose rather than a second identity. Give several
# people their own only when you want to revoke one without touching the others:
# revoking is removing an entry and restarting.
#
# Generate with:  openssl rand -hex 32
APPLAB_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Everything AppLab remembers — the apps, their commit and build history, and
# every app's source repository — lives in an S3-compatible bucket. That is what
# makes AppLab stateless: nothing is kept on the replica, so a pod can be
# replaced at any moment and more than one can serve at once.
#
# Endpoint and bucket are required, and there is no local fallback at all —
# including for development. There used to be one, and it was a trap: a
# deployment that forgot these did not fail, it wrote to a directory inside the
# pod and lost every app the next time the pod moved, having logged nothing
# wrong. A missing bucket is now a boot error that names the setting.
#
# The bucket has to exist already, and its name, region and lifecycle policy are
# yours to decide. AppLab does not create one.
#
# For development, run MinIO locally and point at it:
#   docker run -d -p 9000:9000 -e MINIO_ROOT_USER=applab \
#     -e MINIO_ROOT_PASSWORD=devdevdev minio/minio server /data
#   # then create the bucket, with the mc client or the console
# and set endpoint=http://localhost:9000, path_style=true, insecure=true.
APPLAB_OBJECT_STORE_ENDPOINT=https://s3.us-east-1.amazonaws.com
APPLAB_OBJECT_STORE_BUCKET=applab
APPLAB_OBJECT_STORE_REGION=us-east-1
APPLAB_OBJECT_STORE_ACCESS_KEY=
APPLAB_OBJECT_STORE_SECRET_KEY=
#
# Path-style puts the bucket in the request path rather than in the hostname.
# Most self-hosted services need it, since they have no wildcard DNS to put a
# bucket under, as does any bucket name containing a dot.
# APPLAB_OBJECT_STORE_PATH_STYLE=false
#
# An optional key prefix, so one bucket can hold more than one AppLab.
# APPLAB_OBJECT_STORE_PREFIX=
#
# Allow an http endpoint. Explicit rather than inferred from the scheme: sending
# a credential and an app's source in the clear is a decision, not a default.
# APPLAB_OBJECT_STORE_INSECURE=false

# Scratch space, and only that. A repository is copied here while git runs
# against it and removed afterwards; nothing durable is written to it, so it
# needs no volume and survives no restart.
APPLAB_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Apps
# ---------------------------------------------------------------------------
# The one hostname this installation lives on: apps are published under it, so
# an app with id "shop" is served at shop.<host>, and the console and API are
# reached at it too. Set from the chart's ingress.host.
#
# Leave empty and apps get no hostname, reachable only inside the cluster.
APPLAB_BASE_DOMAIN=

# Serves every app from one host under one path instead of giving each its own
# subdomain: with /apps, an app with id "shop" is served at
# <domain>/applab/apps/shop — nested under APPLAB_BASE_PATH above, which is the
# path the gateway routes on.
#
# The point is the certificate: a subdomain per app needs a wildcard DNS record
# and a wildcard certificate, and one host with a path prefix needs neither.
# Costs the apps a shared origin — browser limits and cookies are shared between
# them. Requires APPLAB_BASE_DOMAIN — the chart's ingress.host — since the
# prefix is what tells the apps on that host apart. AppLab strips the prefix
# before the app sees it.
#
# APPLAB_PATH_PREFIX=/apps

# The one namespace AppLab uses: it runs there, and every app it deploys lives
# there too. That is what lets it hold a namespaced Role rather than a
# ClusterRole — it has no permission anywhere else in the cluster.
#
# The cost is that a namespace no longer separates one app's objects from
# another's; the applab.io/app label does.
APPLAB_NAMESPACE=ops-system

# ---------------------------------------------------------------------------
# Build pipeline
#
# The pipeline is available when registry and kaniko_image are both set. Leaving
# either empty disables it: source storage, the API and the console still work,
# and apps can be deployed from images built elsewhere.
#
# Builds run as a Kubernetes Job per build, with kaniko. It clones the app's
# repository at the commit being built, runs its Dockerfile, and pushes the
# image — no daemon, and nothing privileged. It does run as root: kaniko has no
# unprivileged mode, because it unpacks the base image into its own root
# filesystem, and a Dockerfile's RUN steps happen there. See the chart README.
#
# The node pulls this image, so a cluster that cannot reach ghcr.io needs it
# mirrored. It is the maintained community build of kaniko; Google's
# GoogleContainerTools/kaniko was archived in June 2025.
# ---------------------------------------------------------------------------
# APPLAB_BUILD_REGISTRY=registry.example.com/apps
APPLAB_BUILD_KANIKO_IMAGE=ghcr.io/osscontainertools/kaniko:v1.26.2

# Registry-side layer cache, as a repository per app under <prefix>. A Job has no
# persistent disk, so without this every build starts from nothing.
# APPLAB_BUILD_CACHE_REPO_PREFIX=registry.example.com/cache

# The registry credential: a docker-registry Secret in AppLab's own namespace,
# used to push the built image and referenced by every app to pull it. Defaults
# to "applab", so a Secret by that name needs nothing here. Set it to "" when the
# registry needs no authentication, which is normal for a cluster-local one. If
# it is named and missing, the build or deploy is refused before anything is
# created.
APPLAB_BUILD_SECRET=applab-registry

# Treat the registry as plain HTTP or as having an untrusted certificate. This
# weakens the guarantee that the image that arrived is the image that was
# pushed, so it is off by default.
APPLAB_BUILD_INSECURE_REGISTRY=false

# Bounds for the build container. Builds are bursty and unbounded by nature;
# without limits a runaway build can evict its neighbours.
APPLAB_BUILD_CPU_REQUEST=500m
APPLAB_BUILD_MEMORY_REQUEST=1Gi
APPLAB_BUILD_CPU_LIMIT=4
APPLAB_BUILD_MEMORY_LIMIT=8Gi

# The ephemeral storage a build may use — its source tree plus the image it is
# assembling, which kaniko holds in the container's own writable layer — and how
# long a single build may run before it is killed.
APPLAB_BUILD_WORKSPACE_SIZE_LIMIT=10Gi
APPLAB_BUILD_TIMEOUT=30m

# How long a finished build's Job is kept after it ends, so its log can still be
# read. Counted from the moment it reaches a terminal state. Zero would delete it
# the instant it ended and make every failure undiagnosable.
APPLAB_BUILD_TTL_AFTER_FINISHED=30m

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------
# The Istio gateway apps are published through, as "<namespace>/<name>".
#
# The gateway is cluster infrastructure that already exists: it holds the
# listeners and the certificate for the whole domain. AppLab attaches a
# VirtualService to it and never creates it. Required whenever base_domain is
# set — a VirtualService with no gateway is reachable only from inside the mesh,
# so the app would deploy, report healthy, and be unreachable.
#
# TLS is not configured here. An app is served over HTTPS when the gateway has an
# HTTPS listener.
# APPLAB_DEPLOY_GATEWAY=istio-ingress/istio-ingress

# Applied to every app AppLab deploys. An uploaded app cannot be trusted to
# declare sane limits for itself, and one with none can take its node down.
APPLAB_DEPLOY_APP_CPU_REQUEST=100m
APPLAB_DEPLOY_APP_MEMORY_REQUEST=128Mi
APPLAB_DEPLOY_APP_CPU_LIMIT=2
APPLAB_DEPLOY_APP_MEMORY_LIMIT=2Gi

# ---------------------------------------------------------------------------
# App configuration
#
# Per app rather than per installation, and changed while the deployment runs,
# so there is nothing to set here. It is managed with `applab env`, or the
# matching API routes.
#
# Two kinds of value, split by sensitivity:
#
#   applab env set shop LOG_LEVEL=debug
#     A plain variable. Stored with the app in the object store, applied to the
#     container as an environment variable, and visible to anyone who can read
#     the Deployment.
#
#   applab env secret set shop DATABASE_URL=...
#     A secret. Kept the same way, and reaching the container the same way; the
#     difference is that no API route returns a value, only the names. It is
#     written into the Deployment's environment, so anyone who can read that
#     Deployment can read it.
#
# Either way the change takes effect on the next deploy, not immediately:
# configuration travels the same path as code. The deployer hashes the whole
# configuration into the pod template, which is what makes a changed secret
# actually roll the pods.
#
# PORT cannot be set: it comes from the app's port setting, which is what the
# Service targets.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
# The largest source archive accepted in one request. Anything larger must use
# the chunked endpoints. Keep this at or below the body limit of whatever proxy
# sits in front — a rejected body from an ingress arrives as HTML, not JSON.
APPLAB_MAX_SIMPLE_UPLOAD=8388608

# Part size advertised by the chunked upload endpoints, and the hard ceiling on
# a single part. chunk_size must not exceed max_simple_upload.
APPLAB_CHUNK_SIZE=8388608
APPLAB_MAX_CHUNK_BYTES=33554432

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
# Empty means use in-cluster config, falling back to the ambient kubeconfig —
# which is what makes AppLab runnable outside a cluster during development.
APPLAB_KUBECONFIG=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# One of debug, info, warn, error.
APPLAB_LOG_LEVEL=info
