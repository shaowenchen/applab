# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# An optional YAML file of the same settings, as an alternative to a long
# environment block. Precedence, lowest to highest: built-in defaults, this
# file, then the environment — so anything set below overrides the file.
# APPLAB_CONFIG=/etc/applab/config.yaml

# Address the HTTP server binds. The port must match the container port and the
# Service target in the Helm chart.
APPLAB_LISTEN=:8080

# The public address callers reach this deployment at, used wherever a URL is
# handed back (clone URLs, llms.txt links). Leave empty to derive it from the
# request's Host header — correct behind an ingress, wrong the moment a proxy
# rewrites Host, so setting it explicitly is the safer deployment.
# APPLAB_BASE_URL=https://applab.example.com

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# The keys this deployment accepts. A key is the whole identity: there is no
# user store, so a key that authenticates may do anything, including delete.
#
# APPLAB_KEY takes one key; APPLAB_KEYS takes a comma-separated list. Both are
# merged, so giving each caller its own key is the intended way to work —
# revoking one is removing an entry and restarting.
#
# Generate with:  openssl rand -hex 32
APPLAB_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where applab keeps its database and every app's source repository. In
# Kubernetes this is a PersistentVolume and must be backed up: it is the only
# copy of the apps' source.
APPLAB_DATA_DIR=./data

# The database file. Defaults to <data_dir>/applab.db.
# APPLAB_DB_PATH=./data/applab.db

# ---------------------------------------------------------------------------
# Apps
# ---------------------------------------------------------------------------
# Domain apps are exposed under, so an app with id "shop" is served at
# shop.<domain>. Leave empty and apps get no hostname, reachable only inside the
# cluster.
APPLAB_BASE_DOMAIN=

# The one namespace applab uses: it runs there, and every app it deploys lives
# there too. That is what lets it hold a namespaced Role rather than a
# ClusterRole — it has no permission anywhere else in the cluster.
#
# The cost is that a namespace no longer separates one app's objects from
# another's; the applab.io/app label does.
APPLAB_NAMESPACE=ops-system

# ---------------------------------------------------------------------------
# Build pipeline
#
# The pipeline is available when registry, builder_image and fetcher_image are
# all set. Leaving any of them empty disables it: source storage, the API and
# the console still work, and apps can be deployed from images built elsewhere.
#
# Builds run as a Kubernetes Job per build, with BuildKit rootless by default.
# Rootless needs the node to permit unprivileged user namespaces — see the chart
# README. build_rootless=false is the escape hatch for a cluster that cannot,
# at the cost of running builds with full privileges, and a build runs code from
# whoever pushed the source.
# ---------------------------------------------------------------------------
# APPLAB_BUILD_REGISTRY=registry.example.com/apps
# APPLAB_BUILD_BUILDER_IMAGE=moby/buildkit:v0.19.0
# APPLAB_BUILD_FETCHER_IMAGE=alpine:3.21
APPLAB_BUILD_ROOTLESS=true

# Registry-side layer cache, under <prefix>/<app>:buildcache. A Job has no
# persistent disk, so without this every build starts from nothing.
# APPLAB_BUILD_CACHE_REPO_PREFIX=registry.example.com/cache

# A docker-registry Secret, in applab's own namespace, that builds push with.
# applab copies it into each app's namespace, since a Secret cannot be
# referenced across a namespace boundary. If it is named and missing, a build
# fails before its Job is created.
# APPLAB_BUILD_PUSH_SECRET=regcred

# Treat the registry as plain HTTP or as having an untrusted certificate. This
# weakens the guarantee that the image that arrived is the image that was
# pushed, so it is off by default.
APPLAB_BUILD_INSECURE_REGISTRY=false

# Bounds for the build container. Builds are bursty and unbounded by nature;
# without limits a runaway build can evict its neighbours.
APPLAB_BUILD_CPU_REQUEST=500m
APPLAB_BUILD_MEMORY_REQUEST=1Gi
APPLAB_BUILD_CPU_LIMIT=4
APPLAB_BUILD_MEMORY_LIMIT=8Gi

# The ephemeral volume the source and BuildKit's intermediate state share, and
# how long a single build may run before it is killed.
APPLAB_BUILD_WORKSPACE_SIZE_LIMIT=10Gi
APPLAB_BUILD_TIMEOUT=30m

# How long a finished build's Job is kept, so its log can still be read. Zero
# would delete it the moment it ends and make every failure undiagnosable.
APPLAB_BUILD_TTL_AFTER_FINISHED=24h

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------
# The Istio gateway apps are published through, as "<namespace>/<name>".
#
# The gateway is cluster infrastructure that already exists: it holds the
# listeners and the certificate for the whole domain. applab attaches a
# VirtualService to it and never creates it. Required whenever base_domain is
# set — a VirtualService with no gateway is reachable only from inside the mesh,
# so the app would deploy, report healthy, and be unreachable.
#
# TLS is not configured here. An app is served over HTTPS when the gateway has an
# HTTPS listener.
# APPLAB_DEPLOY_GATEWAY=istio-ingress/istio-ingress

# A docker-registry Secret, in applab's own namespace, that app Deployments pull
# with. Separate from the build one: pushing and pulling can need different
# credentials. Referenced directly rather than copied, since apps run in that
# same namespace.
# APPLAB_DEPLOY_IMAGE_PULL_SECRET=regcred

# Applied to every app applab deploys. An uploaded app cannot be trusted to
# declare sane limits for itself, and one with none can take its node down.
APPLAB_DEPLOY_APP_CPU_REQUEST=100m
APPLAB_DEPLOY_APP_MEMORY_REQUEST=128Mi
APPLAB_DEPLOY_APP_CPU_LIMIT=2
APPLAB_DEPLOY_APP_MEMORY_LIMIT=2Gi

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
# The largest source archive accepted in one request. Anything larger must use
# the chunked endpoints. Keep this at or below the body limit of whatever proxy
# sits in front — a rejected body from an ingress arrives as HTML, not JSON.
APPLAB_MAX_SIMPLE_UPLOAD=8388608

# Part size advertised by the chunked upload endpoints, and the hard ceiling on
# a single part. chunk_size must not exceed max_simple_upload.
APPLAB_CHUNK_SIZE=8388608
APPLAB_MAX_CHUNK_BYTES=33554432

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
# Empty means use in-cluster config, falling back to the ambient kubeconfig —
# which is what makes applab runnable outside a cluster during development.
APPLAB_KUBECONFIG=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# One of debug, info, warn, error.
APPLAB_LOG_LEVEL=info
